<%- include('partials/header') %>

<header class="navbar">
    <div class="nav-container">
        <div class="logo">Coop<span>Seva</span></div>
        <nav id="navLinks">
            <a href="/dashboard">Dashboard</a>
        </nav>
        <div class="nav-buttons">
            <a href="/logout" class="btn login-btn">Logout</a>
        </div>
    </div>
</header>

<div class="auth-wrapper">
  <div class="auth-box" style="max-width:460px;">

    <% if (user.photo) { %>
      <img src="<%= user.photo %>" alt="<%= user.name %>" class="worker-avatar" style="width:80px;height:80px;object-fit:cover;margin:0 auto 16px;display:block;">
    <% } else { %>
      <div class="worker-avatar" style="width:80px;height:80px;font-size:28px;margin:0 auto 16px;"><%= user.name.charAt(0) %></div>
    <% } %>

    <h2 style="text-align:center;">My Profile</h2>
    <p class="subtitle">Manage your account details</p>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>
    <% if (success) { %>
      <p style="background:#e8f5e9;color:#2e7d32;padding:10px 14px;border-radius:8px;font-size:13px;margin-bottom:16px;text-align:center;"><%= success %></p>
    <% } %>

    <form action="/profile" method="POST" enctype="multipart/form-data">

      <label style="font-size:13px;color:#555;">Name</label>
      <input type="text" name="name" value="<%= user.name %>" required>

      <label style="font-size:13px;color:#555;">Email (cannot change)</label>
      <input type="email" value="<%= user.email %>" disabled style="background:#f4f4f4;">

      <label style="font-size:13px;color:#555;">Phone</label>
      <input type="tel" name="phone" value="<%= user.phone %>" required>

      <% if (user.role === 'worker') { %>

        <label style="font-size:13px;color:#555;">Skill</label>
        <select name="skill">
          <option value="electrician" <%= user.skill === 'electrician' ? 'selected' : '' %>>Electrician</option>
          <option value="plumber" <%= user.skill === 'plumber' ? 'selected' : '' %>>Plumber</option>
          <option value="carpenter" <%= user.skill === 'carpenter' ? 'selected' : '' %>>Carpenter</option>
          <option value="cleaner" <%= user.skill === 'cleaner' ? 'selected' : '' %>>Cleaner</option>
          <option value="painter" <%= user.skill === 'painter' ? 'selected' : '' %>>Painter</option>
          <option value="gardener" <%= user.skill === 'gardener' ? 'selected' : '' %>>Gardener</option>
        </select>

        <label style="font-size:13px;color:#555;">Experience (years)</label>
        <input type="number" name="experience" value="<%= user.experience %>">

        <label style="font-size:13px;color:#555;">Address</label>
        <input type="text" name="address" id="addressInput" value="<%= user.location?.address || '' %>">
        <input type="hidden" name="latitude" id="latitudeInput">
        <input type="hidden" name="longitude" id="longitudeInput">

        <button type="button" id="detectLocationBtn" class="btn secondary-btn" style="width:100%;margin-bottom:14px;">
          📍 Update My Current Location
        </button>
        <p id="locationStatus" style="font-size:12px;color:#777;margin-top:-8px;margin-bottom:14px;"></p>

        <label style="font-size:13px;color:#555;">Hourly Rate (₹)</label>
        <input type="number" name="hourlyRate" value="<%= user.hourlyRate %>">

        <label style="font-size:13px;color:#555;">Bio</label>
        <textarea name="bio" rows="3" style="width:100%;padding:12px;border:1px solid #ddd;border-radius:8px;margin-bottom:14px;"><%= user.bio || '' %></textarea>

        <label style="font-size:13px;color:#555;">Update Photo</label>
        <input type="file" name="photo" accept="image/*">

      <% } %>

      <button type="submit" class="btn primary-btn" style="margin-top:10px;">Save Changes</button>
    </form>

  </div>
</div>

<%- include('partials/footer') %>
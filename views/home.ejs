<%- include('partials/header') %>

<header class="navbar">
    <div class="nav-container">
        <div class="logo">Coop<span>Seva</span></div>

        <nav id="navLinks">
            <a href="#home">Home</a>
            <a href="#services">Services</a>
            <a href="#workers">Workers</a>
            <a href="#how">How It Works</a>
            <a href="#about">About</a>
        </nav>

        <div class="nav-buttons">
            <a href="/signin" class="btn login-btn">Login</a>
            <a href="/signup" class="btn primary-btn">Register</a>
        </div>

        <button class="menu-btn" onclick="toggleMenu()">☰</button>
    </div>
</header>

<section id="home" class="hero">
    <div class="hero-content">
        <div class="tag">🤝 Cooperative • Trusted • Local</div>
        <h1>Trusted Services. <span>Fair Opportunities.</span></h1>
        <p>Connect with verified cooperative workers for reliable household and community services.</p>

        <div class="hero-buttons">
            <button class="btn primary-btn large-btn" onclick="showAllServices()">Find a Service</button>
            <a href="/signup" class="btn secondary-btn large-btn">Become a Worker</a>
        </div>

        <div class="stats">
            <div><h2>500+</h2><p>Verified Workers</p></div>
            <div><h2>25+</h2><p>Services</p></div>
            <div><h2>2K+</h2><p>Bookings</p></div>
        </div>
    </div>

    <div class="hero-card">
        <div class="hero-icon">🤝</div>
        <h2>Cooperative First</h2>
        <p>Fair wages, worker welfare and transparent services.</p>
        <div class="features">
            <div>✓ Verified Workers</div>
            <div>✓ Fair Pricing</div>
            <div>✓ Digital Payments</div>
            <div>✓ Worker Welfare</div>
        </div>
    </div>
</section>

<section class="search-section">
    <div class="search-box">
        <div class="search-heading">
            <h2>Find a Service</h2>
            <p>Find trusted workers near you</p>
        </div>

        <div class="search-form">
            <div class="input-box">
    <label>Location</label>
    <input id="searchLocationDisplay" type="text" placeholder="Tap to set on map" readonly style="background:#f9f9f9;cursor:pointer;" onclick="openMapModal('search')">
    <input type="hidden" id="searchLatInput">
    <input type="hidden" id="searchLngInput">
</div>
            <div class="input-box">
                <label>Service</label>
                <select id="service">
                    <option value="">Select service</option>
                    <option value="electrician">Electrician</option>
                    <option value="plumber">Plumber</option>
                    <option value="carpenter">Carpenter</option>
                    <option value="cleaner">Cleaner</option>
                    <option value="painter">Painter</option>
                    <option value="gardener">Gardener</option>
                </select>
            </div>
            <div class="input-box">
                <label>Date</label>
                <input id="date" type="date">
            </div>
            <button class="btn primary-btn search-btn" onclick="searchService()">🔍 Search</button>
        </div>
    </div>
</section>

<section id="services" class="section">
    <div class="section-title">
        <div>
            <small>OUR SERVICES</small>
            <h2>Popular Services</h2>
            <p>Professional services from cooperative workers</p>
        </div>
        <button class="btn secondary-btn" onclick="showAllServices()">View All</button>
    </div>
    <div id="servicesContainer" class="services-grid"></div>
</section>

<section id="workers" class="section light-section">
    <div class="section-title">
        <div>
            <small>VERIFIED PROFESSIONALS</small>
            <h2>Workers Near You</h2>
            <p>Skilled workers verified by cooperative societies</p>
        </div>
    </div>
    <div id="workersContainer" class="workers-grid"></div>
</section>

<section id="how" class="section">
    <div class="center-title">
        <small>SIMPLE PROCESS</small>
        <h2>How CoopSeva Works</h2>
        <p>Get professional services in four simple steps</p>
    </div>
    <div class="steps">
        <div class="step">
            <div class="step-number">01</div>
            <h3>Choose Service</h3>
            <p>Select the service you need.</p>
        </div>
        <div class="step">
            <div class="step-number">02</div>
            <h3>Find Worker</h3>
            <p>Find a verified worker near you.</p>
        </div>
        <div class="step">
            <div class="step-number">03</div>
            <h3>Book Service</h3>
            <p>Select date and time.</p>
        </div>
        <div class="step">
            <div class="step-number">04</div>
            <h3>Pay & Rate</h3>
            <p>Pay securely and rate the service.</p>
        </div>
    </div>
</section>

<section class="welfare">
    <div class="welfare-content">
        <small>WORKER WELFARE</small>
        <h2>More Than Just a Gig Platform</h2>
        <p>CoopSeva helps workers get better opportunities, fair wages and long-term welfare support.</p>
        <div class="welfare-items">
            <div>🛡️ <strong>Insurance Support</strong></div>
            <div>💰 <strong>Fair Wages</strong></div>
            <div>📚 <strong>Skill Certification</strong></div>
            <div>🏥 <strong>Welfare Benefits</strong></div>
        </div>
    </div>
    <div class="earning-card">
        <h3>Worker Earnings</h3>
        <p>This Month</p>
        <h2>₹18,450</h2>
        <div class="progress"><div></div></div>
        <span>↑ 18% compared to last month</span>
    </div>
</section>

<section class="section">
    <div class="ai-box">
        <div class="ai-icon">🤖</div>
        <div>
            <small>AI POWERED</small>
            <h2>Smart Demand Forecasting</h2>
            <p>AI can predict service demand and help cooperative societies allocate workers efficiently.</p>
        </div>
        <button class="btn primary-btn" onclick="showForecast()">View Forecast</button>
    </div>
</section>

<section id="about" class="section about">
    <div class="center-title">
        <small>ABOUT COOPSEVA</small>
        <h2>Built for Cooperative Communities</h2>
        <p>A digital marketplace connecting cooperative workers with households and institutions.</p>
    </div>
    <div class="about-grid">
        <div class="about-card">
            <div class="about-icon">✓</div>
            <h3>Verified Workers</h3>
            <p>Worker identity, skills and certifications can be verified.</p>
        </div>
        <div class="about-card">
            <div class="about-icon">📍</div>
            <h3>Location Matching</h3>
            <p>Find workers based on location and service requirements.</p>
        </div>
        <div class="about-card">
            <div class="about-icon">💳</div>
            <h3>Digital Payments</h3>
            <p>Secure payments and transparent invoices.</p>
        </div>
        <div class="about-card">
            <div class="about-icon">⭐</div>
            <h3>Ratings</h3>
            <p>Customers can rate workers after every service.</p>
        </div>
    </div>
</section>

<footer>
    <div class="footer-content">
        <div>
            <div class="logo">Coop<span>Seva</span></div>
            <p>Cooperative Gig Services Platform</p>
        </div>
        <div class="footer-links">
            <a href="#home">Home</a>
            <a href="#services">Services</a>
            <a href="#workers">Workers</a>
            <a href="#about">About</a>
        </div>
    </div>
    <div class="copyright">© 2026 CoopSeva. All Rights Reserved.</div>
</footer>

<div id="toast" class="toast">
    <span id="toastMessage">Success</span>
</div>

<script src="/js/app.js"></script>



<%- include('partials/footer') %>
<div id="mapModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.6);z-index:2000;overflow-y:auto;">
  <div style="background:#fff;width:92%;max-width:650px;margin:3vh auto;border-radius:12px;max-height:94vh;display:flex;flex-direction:column;">

    <div style="padding:16px 20px;border-bottom:1px solid #eee;display:flex;justify-content:space-between;align-items:center;flex-shrink:0;">
      <h3 style="margin:0;">Set Your Location</h3>
      <button onclick="closeMapModal()" style="background:none;border:none;font-size:24px;cursor:pointer;">×</button>
    </div>

    <div style="padding:16px 20px;overflow-y:auto;flex:1;">
      <div style="display:flex;gap:8px;margin-bottom:12px;">
        <input type="text" id="modalSearchInput" placeholder="Search area, landmark, pincode..." style="flex:1;padding:12px;border:1px solid #ddd;border-radius:8px;">
        <button type="button" onclick="useMyLocationInModal()" class="btn secondary-btn" style="white-space:nowrap;">📍 Current</button>
      </div>
      <div id="modalMap" style="height:300px;border-radius:8px;"></div>
      <p style="font-size:12px;color:#777;margin:10px 0;">📍 Map pe click ya marker drag karke exact location set karo</p>
      <p id="modalAddressPreview" style="font-size:13px;color:#333;background:#f4f4f4;padding:10px;border-radius:8px;min-height:20px;"></p>
    </div>

    <div style="padding:16px 20px;border-top:1px solid #eee;text-align:right;flex-shrink:0;">
      <button onclick="confirmMapLocation()" class="btn primary-btn full-btn">Confirm Location</button>
    </div>

  </div>
</div>

<script src="/js/app.js"></script>
</body>
</html>